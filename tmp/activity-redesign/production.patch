diff --git a/apps/web/src/components/learning/activities/activity-ui.module.css b/apps/web/src/components/learning/activities/activity-ui.module.css
new file mode 100644
index 0000000..0cce50f
--- /dev/null
+++ b/apps/web/src/components/learning/activities/activity-ui.module.css
@@ -0,0 +1,127 @@
+.session {
+  --activity-accent: #2458ee;
+  --activity-ink: #17233b;
+  --activity-muted: #63708a;
+  --activity-line: #dce3ef;
+  --activity-soft: #f4f7fc;
+  width: min(100%, 760px);
+  min-width: 0;
+  margin-inline: auto;
+  padding: 16px 20px calc(28px + env(safe-area-inset-bottom));
+  color: var(--activity-ink);
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  overflow-wrap: anywhere;
+}
+.header { position: relative; margin-bottom: 32px; }
+.immersive { isolation: isolate; }
+.headerRow { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; align-items: center; gap: 10px; }
+.headerTitle { min-width: 0; }
+.headerTitle > span { display: block; margin-bottom: 3px; color: var(--activity-muted); font-size: 12px; line-height: 1.4; }
+.headerTitle h1 { margin: 0; font-size: 15px; line-height: 1.35; font-weight: 600; letter-spacing: -.015em; }
+.iconButton { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; border-radius: 14px; background: transparent; color: var(--activity-accent); cursor: pointer; list-style: none; }
+.iconButton::-webkit-details-marker { display: none; }
+.iconButton:hover { background: #edf2ff; }
+.sessionDetails { position: relative; }
+.sessionDetails[open] > summary { background: #edf2ff; }
+.detailsPanel { position: absolute; right: 0; top: 50px; z-index: 20; width: min(340px, calc(100vw - 40px)); max-height: 65svh; overflow: auto; border: 1px solid var(--activity-line); border-radius: 18px; padding: 20px; background: #fff; box-shadow: 0 12px 40px #17233b16; font-size: 13px; line-height: 1.6; }
+.detailsPanel > strong { display: block; margin-bottom: 12px; font-size: 15px; }
+.detailsPanel p { margin: 10px 0; }
+.progress { display: flex; align-items: center; gap: 14px; margin-top: 20px; }
+.progress progress { flex: 1; width: 100%; min-width: 0; height: 6px; overflow: hidden; appearance: none; border: 0; border-radius: 99px; background: #eaf0f9; }
+.progress progress::-webkit-progress-bar { border-radius: 99px; background: #eaf0f9; }
+.progress progress::-webkit-progress-value { border-radius: 99px; background: var(--activity-accent); transition: width 180ms ease; }
+.progress progress::-moz-progress-bar { border-radius: 99px; background: var(--activity-accent); }
+.progress > span { flex: 0 0 auto; color: var(--activity-muted); font-size: 13px; font-variant-numeric: tabular-nums; }
+.content { min-width: 0; animation: appear 180ms ease-out; }
+.prompt { margin: 0 0 24px; font-size: clamp(23px, 5.7vw, 30px); line-height: 1.28; font-weight: 650; letter-spacing: -.035em; white-space: pre-wrap; }
+.eyebrow { margin: 0 0 10px; color: var(--activity-muted); font-size: 13px; font-weight: 500; }
+.context { margin: 0 0 24px; border-left: 3px solid #cbd8f5; padding: 2px 0 2px 16px; font-size: 15px; line-height: 1.65; color: #4f5e76; white-space: pre-wrap; }
+.session :global(.learning-question-card),
+.session :global(.learning-guide-activity),
+.session :global(.learning-flashcard),
+.session :global(.learning-video-activity),
+.session :global(.learning-completion-panel) { display: grid; gap: 20px; margin: 0; padding: 0; border: 0; border-radius: 0; box-shadow: none; background: transparent; }
+.session :global(.learning-question-card) h2,
+.session :global(.learning-flashcard) h2,
+.session :global(.learning-guide-activity) h2,
+.session :global(.learning-video-activity) h2 { font-size: clamp(23px, 5.7vw, 30px); line-height: 1.28; letter-spacing: -.035em; }
+.session :global(.learning-activity-counter) { color: var(--activity-muted); font-size: 13px; letter-spacing: 0; text-transform: none; font-weight: 500; }
+.session :global(.learning-primary-button) { display: inline-flex; min-height: 52px; width: 100%; justify-content: center; justify-self: stretch; align-items: center; gap: 8px; padding: 13px 20px; border: 1px solid transparent; border-radius: 16px; background: var(--activity-accent); box-shadow: none; color: #fff; font-size: 16px; font-weight: 600; line-height: 1.4; cursor: pointer; transition: background 140ms ease, transform 140ms ease; }
+.session :global(.learning-primary-button):hover:not(:disabled) { background: #1646d0; }
+.session :global(.learning-primary-button):active:not(:disabled) { transform: scale(.99); }
+.session :global(.learning-primary-button):disabled { background: #e6ebf5; color: #677590; opacity: 1; cursor: default; }
+.session :global(.learning-secondary-button) { min-height: 44px; border: 1px solid var(--activity-line); border-radius: 13px; box-shadow: none; background: #fff; color: #465575; padding: 10px 14px; font-size: 14px; font-weight: 500; }
+.session :is(button, a, summary, textarea, input, select):focus-visible { outline: 3px solid #8bacff; outline-offset: 3px; }
+.session :is(h2, h3)[tabindex="-1"]:focus { outline: none; }
+.session fieldset { min-width: 0; }
+.session :global(.learning-question-card) fieldset { gap: 10px; }
+.session :global(.learning-question-card) fieldset > label { min-height: 58px; gap: 12px; border-color: var(--activity-line); border-radius: 15px; padding: 14px 16px; color: var(--activity-ink); background: #fff; font-size: 16px; line-height: 1.4; transition: border-color 140ms ease, background 140ms ease; }
+.session :global(.learning-question-card) fieldset > label:has(input:checked) { border-color: var(--activity-accent); background: #f0f5ff; }
+.session :global(.learning-question-card) input[type="radio"] { width: 20px; height: 20px; margin: 0; accent-color: var(--activity-accent); }
+.inputField { position: relative; }
+.inputField textarea { display: block; resize: vertical; width: 100%; min-width: 0; min-height: 150px; border: 1px solid #cdd7e9; border-radius: 16px; padding: 18px 18px 38px; font: inherit; font-size: 16px; line-height: 1.6; color: var(--activity-ink); background: #fff; }
+.inputField textarea::placeholder { color: #7d89a0; }
+.characterCount { position: absolute; right: 16px; bottom: 12px; margin: 0; color: var(--activity-muted); font-size: 12px; font-variant-numeric: tabular-nums; pointer-events: none; }
+.tools { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
+.tools button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; border: 0; border-radius: 14px; background: #f1f5fd; color: #3b568e; font-size: 14px; font-weight: 500; cursor: pointer; }
+.tools button[aria-pressed="true"] { background: #e6eeff; color: #1746cb; }
+.tools button:disabled { opacity: .5; cursor: default; }
+.help { position: relative; margin-top: 10px; padding: 18px; border-radius: 16px; background: #f1f5fd; color: #435a85; font-size: 14px; line-height: 1.65; white-space: pre-wrap; }
+.help h3 { margin: 0 36px 8px 0; font-size: 14px; }
+.help p { margin: 0; }
+.help small { display: block; margin-top: 10px; color: #657594; }
+.help > button { position: absolute; top: 5px; right: 5px; border: 0; background: transparent; color: inherit; min-width: 44px; min-height: 44px; cursor: pointer; }
+.action { position: sticky; bottom: max(16px, env(safe-area-inset-bottom)); z-index: 5; margin-top: 8px; border-radius: 16px; box-shadow: 0 0 0 8px #fff, 0 10px 24px #fff; }
+.notice { margin: 16px 0; padding: 16px; border: 1px solid #e5d5a8; border-radius: 15px; color: #705526; background: #fff9ec; font-size: 14px; line-height: 1.6; }
+.notice p { margin: 0 0 12px; }
+.feedback { margin: 0 0 20px; padding: 20px; border: 1px solid #cbe8d8; border-radius: 18px; color: #187045; background: #effaf3; }
+.feedback[data-tone="incorrect"] { color: #8b5720; background: #fff8ed; border-color: #ecdcc2; }
+.feedback[data-tone="neutral"] { color: #375b94; background: #f1f5fd; border-color: #dbe5f5; }
+.feedback h3 { display: flex; align-items: center; gap: 9px; margin: 0; font-size: 18px; letter-spacing: -.02em; }
+.feedback p { margin-top: 10px; font-size: 15px; line-height: 1.65; white-space: pre-wrap; }
+.answerRecap { margin-bottom: 16px; padding: 18px; border: 1px solid var(--activity-line); border-radius: 16px; font-size: 18px; white-space: pre-wrap; line-height: 1.5; }
+.disclosure { margin: 12px 0 20px; border-radius: 15px; background: var(--activity-soft); font-size: 14px; line-height: 1.65; }
+.disclosure > summary { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 12px 16px; color: #475c80; cursor: pointer; list-style: none; font-weight: 500; }
+.disclosure > summary::-webkit-details-marker { display: none; }
+.disclosure > summary::after { content: "+"; margin-left: auto; font-size: 20px; }
+.disclosure[open] > summary::after { content: "−"; }
+.disclosure > :not(summary) { margin: 0; padding: 0 16px 16px; }
+.disclosure article + article { border-top: 1px solid var(--activity-line); padding-top: 16px; }
+.disclosure h3, .disclosure h4 { font-size: 14px; margin: 8px 0; }
+.disclosure blockquote { border-left: 2px solid #c9d6ed; padding-left: 12px; margin: 12px 0; white-space: pre-wrap; }
+.comparison { display: grid; gap: 16px; }
+.comparison > article { padding: 18px; border: 1px solid var(--activity-line); border-radius: 16px; }
+.comparison h3 { color: var(--activity-muted); font-size: 13px; font-weight: 500; margin: 0 0 10px; }
+.comparison p { font-size: 16px; line-height: 1.65; white-space: pre-wrap; }
+.ratings { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; border: 0; padding: 0; margin: 4px 0 0; }
+.ratings legend { margin-bottom: 12px; color: var(--activity-muted); font-size: 14px; }
+.ratings button { white-space: normal; }
+.completion { display: grid; justify-items: center; gap: 16px; padding-top: 20px; text-align: center; }
+.completion > svg { color: #219562; }
+.completion h2 { font-size: 28px; letter-spacing: -.03em; }
+.completion > p { color: var(--activity-muted); font-size: 15px; line-height: 1.6; }
+.completion > div, .completion > details { width: 100%; text-align: left; }
+.completion > a { color: #546586; font-size: 14px; min-height: 44px; display: inline-flex; align-items: center; gap: 8px; }
+.session :global(.learning-flashcard) > article { min-height: 250px; padding: 26px 18px; border-radius: 20px; border: 1px solid var(--activity-line); background: #fafbfe; }
+.session :global(.learning-flashcard) > article > span,
+.session :global(.learning-flashcard-back) > span { color: #57667e; letter-spacing: 0; text-transform: none; font-weight: 500; font-size: 13px; }
+.session :global(.learning-recall-grades) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.session :global(.learning-recall-grades) button { min-height: 52px; border-radius: 14px; }
+.session :global(.learning-guide-activity) > article { min-height: auto; padding: 0; border: 0; background: transparent; }
+.session :global(.learning-guide-activity) > article p { color: #3e4e69; line-height: 1.8; font-size: 16px; }
+.session :global(.learning-feedback) { margin-top: 0; padding: 20px; border-radius: 18px; }
+.session :global(.learning-feedback) :global(.learning-primary-button) { grid-column: 1 / -1; }
+@keyframes appear { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
+@media (min-width: 700px) {
+  .session { margin-top: 24px; padding: 28px 42px 36px; border: 1px solid var(--activity-line); border-radius: 28px; background: #fff; box-shadow: 0 12px 48px #17233b06; }
+  .header { margin-bottom: 40px; }
+  .headerTitle h1 { font-size: 16px; }
+  .comparison { grid-template-columns: 1fr 1fr; }
+  .inputField textarea { min-height: 175px; }
+}
+@media (max-width: 359px) { .session { padding-inline: 16px; } .ratings { grid-template-columns: 1fr; } }
