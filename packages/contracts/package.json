{
  "name": "@cediah/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node bin/generate-learning-route-schema.mjs",
    "bundle:route": "node bin/bundle-learning-route.mjs",
    "typecheck": "tsc --noEmit",
    "validate:route": "node bin/validate-learning-route.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
